<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Title>FunStripe Sample Application</Title>
    <Description>A sample application demonstrating FunStripe usage patterns</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="StripeService.fs" />
    <Compile Include="../webhooks/Events.fs" />
    <Compile Include="../webhooks/WebhookHandler.fs" />
    <Compile Include="../webhooks/WebhookSamples.fs" />
    <Compile Include="IntegrationExample.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FunStripe.Core" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
  </ItemGroup>

</Project>